# --------------------------------------------------------------------------
#
# MiSTer project
#
# WARNING WARNING WARNING:
# Do not add files to project in Quartus IDE! It will mess this file!
# Add the files manually to files.qip file.
#
# --------------------------------------------------------------------------

set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Standard Edition"

set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SAVE_DISK_SPACE OFF
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name TIMEQUEST_MULTICORNER_ANALYSIS ON
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name FINAL_PLACEMENT_OPTIMIZATION ALWAYS
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE ON
set_global_assignment -name QII_AUTO_PACKED_REGISTERS "SPARSE AUTO"
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_EFFORT EXTRA
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
# Not inside the CPU: Minimig.sdc relaxes the CPU's tick-gated registers by
# NAME (four cycles between core_enable-gated registers, three from RAM
# ports and the MMU pipe), and a register the fitter retimes across logic
# is re-clocked every cycle -- it launches the cycle after the tick, yet
# inherits the hierarchy's four-cycle grant.  The a6144508 fit had 47 such
# _OTERM/NEW_REG copies of epf_count/epf_fill/epf_head (tests/ap040/sta
# census).  Duplication is fine: an exact copy keeps its enable.
set_instance_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING OFF -to emu|cpu_wrapper
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name AUTO_DELAY_CHAINS_FOR_HIGH_FANOUT_INPUT_PINS ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA ON
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION ON
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT LOW
set_global_assignment -name OPTIMIZE_POWER_DURING_SYNTHESIS OFF
set_global_assignment -name ROUTER_REGISTER_DUPLICATION ON
set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name PLACEMENT_EFFORT_MULTIPLIER 4.0
set_global_assignment -name ROUTER_TIMING_OPTIMIZATION_LEVEL MAXIMUM
set_global_assignment -name SEED 2
set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"
set_global_assignment -name VERILOG_MACRO "MISTER_FB_PALETTE=1"

source sys/sys.tcl
# AP040X2 X2.1b: dual-SDRAM build variant.  To drive the io-board's second
# SDRAM as the upper 16 bits of a 32-bit bus, define the macro and swap the
# analog tcl for the dual-SDRAM pin map (the second SDRAM takes the analog
# IO pins, so the variant has no VGA):
#   set_global_assignment -name VERILOG_MACRO "MISTER_DUAL_SDRAM=1"
#   source sys/sys_dual_sdram.tcl     (instead of sys/sys_analog.tcl)
# Boards without the second module are refused at runtime: the controller's
# init probe (sdram32_ctrl dual_ok) holds the machine in reset rather than
# letting half of every chip-RAM longword vanish silently.
source sys/sys_analog.tcl
source files.qip

# SDRAM_A[11] and SDRAM_A[12] out of their I/O registers.
#
# sys/sys.tcl packs every SDRAM output into the pin's own register
# (FAST_OUTPUT_REGISTER ON -to SDRAM_*).  Eleven of the thirteen address
# pins sit together; A[11] (PIN_AD17) and A[12] (PIN_D12) are on the far
# side of the die from ram1, and EVERY setup failure this design has had
# for days ends at one of those two: the last hop from the controller's
# logic to the pin register is 4.089 ns of pure interconnect, 22% of the
# 17.616 ns budget.  It is what makes the chipset's Agnus-to-SDRAM address
# path the worst path in the design -- in the last flashable build too,
# where it cleared by 0.091 ns.
#
# Unpacking those two lets the fitter put their registers beside the logic
# that feeds them, and the long trip becomes clock-to-output instead of a
# timed internal path.  What that spends is pin-level margin, and there is
# plenty: sdram_ctrl drives SDRAM_CLK from sdram_state[0], so an SDRAM
# cycle is two clk_114 cycles (57 MHz), and the address is driven for
# states 1 and 2 with the clock rising between them -- 8.8 ns of setup and
# 8.8 ns of hold at the pins.  A fabric register adds a few ns of
# clock-to-output on these two bits; the SDRAM needs about 1.5 ns of setup,
# so the margin covers it several times over.  Address bits are sampled
# independently, so skew against the other eleven does not matter.
set_instance_assignment -name FAST_OUTPUT_REGISTER OFF -to SDRAM_A[11]
set_instance_assignment -name FAST_OUTPUT_REGISTER OFF -to SDRAM_A[12]
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
