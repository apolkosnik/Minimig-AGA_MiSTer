# fx68k 68000/68010 test runner.
# Run with: vsim -c -do run_fx68k.do   (in rtl/sim/fx68k)
# Exit code 0 on PASS, 1 on FAIL.
#
# The test programs (tests/*.s) are assembled to tests/*.hex by build_tests.py
# (needs vasm). tests/random.s is generated by gen_random.py, tests/loop010.s by
# gen_loop.py and tests/timing.s by gen_timing.py.
#
# 68000 mode must give exactly the bus cycles of the original 68000 fx68k: the
# expected trace CRCs below were recorded with the original core. In 68010
# mode the self checking tests must pass, the exception free random program
# must leave the same registers and memory as in 68000 mode, and the CRCs of
# the 68010 runs are recorded to catch changes.
#
# The timing test checks the time of every instruction form against the
# M68000 User's Manual, without wait states. In 68010 mode 6 forms are known
# to differ (DIVS with negative operands, see fx68k.txt).

if {[file exists work]} { vdel -lib work -all }
vlib work
vmap work work

vlog -sv -quiet -suppress 7061,13314 ../../fx68k/fx68kAlu.sv ../../fx68k/uaddrPla.sv ../../fx68k/fx68k.sv
vlog -sv -quiet tb_fx68k.sv
file copy -force ../../fx68k/microrom.mem microrom.mem
file copy -force ../../fx68k/nanorom.mem nanorom.mem

# name cpu010 wait-clocks max-clocks expected-status expected-crc (- = not checked)
set tests {
	{smoke   0 0  100000   0     4da4e156}
	{smoke   0 10 100000   0     d1ab9af6}
	{excep   0 0  3000000  0     43c45d46}
	{excep   0 10 3000000  0     8a7c453c}
	{random  0 0  3000000  0     2ba7780a}
	{random  0 10 3000000  0     aceb3b17}
	{m68010  0 0  3000000  32772 72078fce}
	{m68010  0 10 3000000  32772 431ed5bc}
	{loop010 0 0  30000000 0     cb3232f6}
	{loop010 0 10 40000000 0     f0d6f007}
	{timing  0 0  30000000 0     5e680445}
	{timing  0 10 40000000 -     fd000548}
	{smoke   1 0  100000   0     5621336c}
	{smoke   1 10 100000   0     46c609c6}
	{excep   1 0  3000000  0     c617e371}
	{excep   1 10 3000000  0     88251d93}
	{random  1 0  3000000  0     f70626cf}
	{random  1 10 3000000  0     413aff8b}
	{m68010  1 0  3000000  0     e73a16f7}
	{m68010  1 10 3000000  0     f2cde4b4}
	{loop010 1 0  30000000 0     c39fa2c6}
	{loop010 1 10 40000000 0     0da2bcd1}
	{timing  1 0  30000000 6     b23a9b33}
}

proc readfile {name} {
	set f [open $name r]
	set d [read $f]
	close $f
	return $d
}

set fails 0
foreach t $tests {
	lassign $t name cpu010 wait maxclk est ecrc
	set dump dump_${name}_${cpu010}_${wait}.txt
	vsim -c -quiet -onfinish stop work.tb_fx68k +hex=tests/$name.hex +cpu010=$cpu010 +wait=$wait +maxclk=$maxclk +dump=$dump
	run -all
	set st [examine -radix decimal /tb_fx68k/status]
	set crc [string tolower [examine -radix hex /tb_fx68k/crc]]
	regsub {^.*h} $crc {} crc
	quit -sim
	set ok 1
	set note ""
	if {$est != "-" && $st != $est} { set ok 0 }
	if {$ecrc != "-" && $crc != $ecrc} { set ok 0 }
	# 68010 mode random program: the same results as in 68000 mode
	if {$name == "random" && $cpu010 == 1} {
		if {[readfile $dump] != [readfile dump_random_0_${wait}.txt]} {
			set ok 0
			set note " (results differ from 68000 mode)"
		}
	}
	if {$ok} {
		puts "PASS $name cpu010=$cpu010 wait=$wait status=$st crc=$crc"
	} else {
		puts "FAIL $name cpu010=$cpu010 wait=$wait status=$st (expected $est) crc=$crc (expected $ecrc)$note"
		incr fails
	}
}

if {$fails != 0} {
	puts "RUN: FAIL ($fails tests)"
	quit -code 1
} else {
	puts "RUN: PASS"
	quit -code 0
}
