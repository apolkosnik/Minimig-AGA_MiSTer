# ModelSim flows under rtl/sim: run artefacts, and the one generated source
# (make_sim_sdram.py rewrites sdram_ctrl.v for declaration-before-use).
# *_sim above matches names ENDING in _sim, so sdram_ctrl_sim.v needs its own.
rtl/sim/**/work/
rtl/sim/**/transcript
rtl/sim/**/modelsim.ini
rtl/sim/**/vsim.wlf
rtl/sim/sdram/sdram_ctrl_sim.v

# Quartus compile logs written to the repo root by build.sh, and the crash
# report quartus_sta leaves behind: run artefacts, one per build, not sources.
build_*.log
cr_ie_info.json
