set_global_assignment -name VERILOG_FILE ../../../rtl/ap040/ap040_fpu.v
# The bus16 top (run.sh <work> ap040_pipe_bus16): the 16-bit adapter, the
# data memory unit, the MMU and its ATC rows (bram.vhd's dpram). Unused by
# the ap040_pipe_core fit.
set_global_assignment -name VERILOG_FILE ../../../rtl/ap040_pipe/ap040_pipe_bus16.v
set_global_assignment -name VERILOG_FILE ../../../rtl/ap040/ap040_bus16_adapter.v
set_global_assignment -name VERILOG_FILE ../../../rtl/ap040_pipe/ap040_pipe_dmu.v
set_global_assignment -name VERILOG_FILE ../../../rtl/ap040_pipe/ap040_pipe_mmu.v
set_global_assignment -name VHDL_FILE ../../../rtl/bram.vhd
# The memory units' arrays (doc_AP040_PIPELINE_CACHES.md), and the stage-0
# fit of them alone (run.sh <work> ap040_pipe_cache_fit).
set_global_assignment -name VHDL_FILE ../../../rtl/ap040_pipe/ap040_pipe_ram.vhd
set_global_assignment -name VERILOG_FILE ../../../rtl/ap040_pipe/ap040_pipe_cache_arr.v
set_global_assignment -name VERILOG_FILE ../../../tests/ap040/pipe_synth/ap040_pipe_cache_fit.v
set_global_assignment -name VERILOG_FILE ../../../rtl/ap040_pipe/ap040_writeback.v

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Standard Edition"