set_global_assignment -name SEARCH_PATH ../../../rtl/ap040_pipe
set_global_assignment -name SEARCH_PATH ../../../rtl/ap040
set_global_assignment -name SDC_FILE pipe.sdc
set_parameter -name L1_AW 4
set_instance_assignment -name VIRTUAL_PIN ON -to *
